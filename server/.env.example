# ============================================================
# GitHub Finder — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#
# IMPORTANT: Never commit .env to Git!
# ============================================================

# GitHub Classic Personal Access Token (read:user scope only)
# Generate at: https://github.com/settings/tokens
GITHUB_PAT=ghp_your_personal_access_token_here

# Server port (default: 3001)
PORT=3001

# Aikido Zen in-app firewall (https://github.com/AikidoSec/firewall-node)
# Get the runtime token from your Aikido dashboard (Zen → Add service).
AIKIDO_TOKEN=your_aikido_runtime_token_here
# true = block detected attacks; false/unset = detect & report only
AIKIDO_BLOCK=true

# Frontend URL for CORS (set to your Amplify production URL)
# FRONTEND_URL=https://your-app.amplifyapp.com
