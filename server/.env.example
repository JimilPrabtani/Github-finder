# ============================================================
# GitHub Finder — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#
# IMPORTANT: Never commit .env to Git!
# ============================================================

# GitHub Classic Personal Access Token (read:user scope only)
# Generate at: https://github.com/settings/tokens
GITHUB_PAT=ghp_your_personal_access_token_here

# Server port (default: 3001)
PORT=3001

# Frontend URL for CORS (set to your Amplify production URL)
# FRONTEND_URL=https://your-app.amplifyapp.com
